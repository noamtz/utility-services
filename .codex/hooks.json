{
  "description": "Project guardrails and an append-only local audit trail for Codex shell and edit tools.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^(Bash|apply_patch)$",
        "hooks": [
          {
            "type": "command",
            "command": "uv run --script \"C:/Users/ntzur/workspace-vscode/utility-services/.codex/hooks/pre_tool_use.py\"",
            "commandWindows": "uv run --script \"C:/Users/ntzur/workspace-vscode/utility-services/.codex/hooks/pre_tool_use.py\"",
            "timeout": 10,
            "statusMessage": "Checking project safety rules"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "^(Bash|apply_patch)$",
        "hooks": [
          {
            "type": "command",
            "command": "uv run --script \"C:/Users/ntzur/workspace-vscode/utility-services/.codex/hooks/post_tool_use.py\"",
            "commandWindows": "uv run --script \"C:/Users/ntzur/workspace-vscode/utility-services/.codex/hooks/post_tool_use.py\"",
            "timeout": 10,
            "statusMessage": "Recording local tool activity"
          }
        ]
      }
    ]
  }
}
